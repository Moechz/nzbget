# ===========================================================================
# Multilingual file for the TOS 7 Docker application "nzbgetdocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "NZBGet"
auth         = "NZBGet"
version      = "@@VERSION@@"
descript     = "NZBGet is a lightweight Usenet downloader. It fetches NZBs from your news server over NNTP, verifies and repairs them with PAR2, unpacks the result and keeps a queue you manage from a web UI on port 8017. The package runs the LinuxServer.io image as a non-root container and keeps configuration, queue and downloads in the application data folder. Feeds, notifications and post-processing scripts work only when you configure them."
release_note = "26.3-7: remediation of the App Center review (C3/C4/C5/C6/C8/C9/T1/T2). Added PRIVACY.md with retention, user rights, security measures, third-party sharing and the deletion channel, and NOTICE.md with the verified GPL-2.0 licence, image digests and trademarks. The help field now opens PRIVACY.md. Every outbound endpoint is disclosed (Usenet provider, RSS feeds, GitHub extension catalogue, SMTP, user scripts, Docker Hub) and no telemetry or update check exists. Description rewritten in all languages, including zh-cn and zh-hk, without the ASCII semicolons that truncated the store text. Security: the image's shipped default control password and dummy news-server credentials are removed, a random control password is generated at first start, nzbget.conf is 0600 in a 0700 directory, and all capabilities are dropped. T1: image upgraded from 26.3.20261106 (Alpine 3.24.3) to 26.3.20261120 (Alpine 3.24.4, LinuxServer v26.3-ls273). Port unchanged (8017)."
important    = "Requires DockerEngine (installed automatically if missing). The first start generates a random web login for user nzbget and prints it in the container log (docker logs nzbgetdocker). Add your Usenet provider under Settings -> News Servers. Configuration, queue and downloads stay in the application data folder. Uninstall and delete DockerAppData/nzbgetdocker to erase everything."

[zh-cn]
name         = "NZBGet"
auth         = "NZBGet"
version      = "@@VERSION@@"
descript     = "NZBGet 是轻量的 Usenet 下载器：从你配置的新闻服务器通过 NNTP 下载 NZB，用 PAR2 校验修复并自动解压，网页队列可在 8017 端口管理。本应用以非 root 容器运行 LinuxServer.io 镜像，配置、队列与下载保存在应用数据目录。RSS 订阅、邮件通知与后处理脚本仅在你自行配置后才会工作。"
release_note = "26.3-7：按应用中心审核意见整改（C3/C4/C5/C6/C8/C9/T1/T2）。新增 PRIVACY.md（保留期、用户权利、安全措施、第三方共享、删除渠道）与 NOTICE.md（核实 GPL-2.0、镜像 digest、商标声明），help 字段改为打开 PRIVACY.md。隐私政策逐项披露对外连接（Usenet 服务商、RSS 订阅、GitHub 扩展目录、SMTP、用户脚本、Docker Hub），并说明没有遥测与更新检查。所有语言（含 zh-cn/zh-hk）重写描述，去掉会被商店解析成注释的 ASCII 分号。安全：移除镜像自带的默认控制密码与占位新闻服务器凭据，首次启动生成随机控制密码，nzbget.conf 为 0600、目录 0700，容器丢弃全部 capabilities。T1：镜像由 26.3.20261106（Alpine 3.24.3）升级到 26.3.20261120（Alpine 3.24.4，LinuxServer v26.3-ls273）。端口不变（8017）。"
important    = "需要 DockerEngine（缺失时自动安装）。首次启动会为用户 nzbget 生成随机网页登录密码并打印在容器日志中（docker logs nzbgetdocker）。请在「设置 → 新闻服务器」填写你的 Usenet 服务商。配置、队列与下载都保存在应用数据目录。卸载并删除 DockerAppData/nzbgetdocker 即可清除全部数据。"

[zh-hk]
name         = "NZBGet"
auth         = "NZBGet"
version      = "@@VERSION@@"
descript     = "NZBGet 是輕量的 Usenet 下載器：從你設定的新聞伺服器透過 NNTP 下載 NZB，用 PAR2 校驗修復並自動解壓，網頁佇列可在 8017 埠管理。本應用以非 root 容器執行 LinuxServer.io 映像，設定、佇列與下載保存在應用資料目錄。RSS 訂閱、郵件通知與後處理腳本僅在你自行設定後才會運作。"
release_note = "26.3-7：按應用中心審核意見整改（C3/C4/C5/C6/C8/C9/T1/T2）。新增 PRIVACY.md（保留期、使用者權利、安全措施、第三方共享、刪除管道）與 NOTICE.md（核實 GPL-2.0、映像 digest、商標聲明），help 欄位改為開啟 PRIVACY.md。隱私政策逐項披露對外連線（Usenet 服務商、RSS 訂閱、GitHub 擴充目錄、SMTP、使用者腳本、Docker Hub），並說明沒有遙測與更新檢查。所有語言（含 zh-cn/zh-hk）重寫描述，去掉會被商店解析成註解的 ASCII 分號。安全：移除映像內建的預設控制密碼與佔位新聞伺服器憑證，首次啟動產生隨機控制密碼，nzbget.conf 為 0600、目錄 0700，容器丟棄全部 capabilities。T1：映像由 26.3.20261106（Alpine 3.24.3）升級到 26.3.20261120（Alpine 3.24.4，LinuxServer v26.3-ls273）。埠不變（8017）。"
important    = "需要 DockerEngine（缺少時自動安裝）。首次啟動會為使用者 nzbget 產生隨機網頁登入密碼並列印在容器日誌中（docker logs nzbgetdocker）。請在「設定 → 新聞伺服器」填寫你的 Usenet 服務商。設定、佇列與下載都保存在應用資料目錄。解除安裝並刪除 DockerAppData/nzbgetdocker 即可清除全部資料。"

